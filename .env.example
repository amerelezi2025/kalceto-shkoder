# Kalceto Shkoder Configuration

# 1. Twilio SMS Gateway (for real carrier SMS codes to Albanian phones)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# 2. Infobip SMS Gateway (Alternative Balkan SMS carrier)
# INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
# INFOBIP_SENDER=Kalceto

# 3. Optional Gmail settings
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
